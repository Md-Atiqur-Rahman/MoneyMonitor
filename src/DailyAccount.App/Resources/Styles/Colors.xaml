<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Palette from the approved screen designs (docs/adr/0008-ui-structure-and-navigation.md). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#1E6B4A</Color>
    <Color x:Key="PrimaryDark">#14503A</Color>
    <Color x:Key="PrimaryTint">#E3F0E8</Color>
    <Color x:Key="OnPrimaryMuted">#D5EBDD</Color>
    <Color x:Key="Ink">#16201A</Color>
    <Color x:Key="Muted">#5B6660</Color>
    <Color x:Key="Placeholder">#A3ABA6</Color>
    <Color x:Key="Line">#E2E5DF</Color>
    <Color x:Key="FieldBorder">#CDD2CA</Color>
    <Color x:Key="Ground">#F4F5F1</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Neutral">#EEF0EC</Color>
    <Color x:Key="Warn">#B4441A</Color>
    <Color x:Key="WarnDark">#8F3313</Color>
    <Color x:Key="WarnTint">#FBE9E1</Color>
    <Color x:Key="Info">#1D3F75</Color>
    <Color x:Key="InfoTint">#E6EDF8</Color>

</ResourceDictionary>
