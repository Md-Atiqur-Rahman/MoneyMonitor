<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:ReportsViewModel"
    Shell.NavBarIsVisible="True"
    Title="{loc:Tr Tab_Reports}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Month switcher -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ImageButton Source="chevron_left.png" Command="{Binding PreviousCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Previous month" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{loc:Tr Reports_Title}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Label Text="{Binding Model.MonthTitle}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <ImageButton Grid.Column="2" Source="chevron_right.png" Command="{Binding NextCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Next month" />
            </Grid>

            <!-- All entries of this month: edit / delete (ADR 0026) -->
            <Button Text="{loc:Tr Entries_Open}" Command="{Binding OpenEntriesCommand}" Style="{StaticResource Outline}" />
            <!-- Who owes what (ADR 0040) -->
            <Button Text="{loc:Tr People_Open}" Command="{Binding OpenPeopleCommand}" Style="{StaticResource Outline}" />

            <!-- Cash flow -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr CashFlow}" Style="{StaticResource H2}" />
                    <Label Text="{loc:Tr CashFlowSub}" Style="{StaticResource Muted}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        <!-- Each line opens its details (ADR 0032) -->
                        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFlowCommand}" CommandParameter="in" />
                            </Grid.GestureRecognizers>
                            <Label Text="{loc:Tr Flow_MoneyIn}" TextDecorations="Underline" />
                            <Label Grid.Column="1" Text="{Binding Model.Income}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource Muted}" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFlowCommand}" CommandParameter="dues" />
                            </Grid.GestureRecognizers>
                            <Label Text="{loc:Tr DuesPaid}" TextDecorations="Underline" />
                            <Label Grid.Column="1" Text="{Binding Model.DuesPaid}" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource Muted}" />
                        </Grid>
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFlowCommand}" CommandParameter="spent" />
                            </Grid.GestureRecognizers>
                            <Label Text="{loc:Tr CashExpenses}" TextDecorations="Underline" />
                            <Label Grid.Column="1" Text="{Binding Model.CashExpenses}" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource Muted}" />
                        </Grid>
                        <!-- Due this month, same as Home / Dues; opens the Dues page (ADR 0048) -->
                        <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDuesCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{loc:Tr DuesStill}" TextDecorations="Underline" />
                            <Label Grid.Column="1" Text="{Binding Model.DuesStill}" TextColor="{StaticResource Warn}" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="›" TextColor="{StaticResource Muted}" />
                            <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Model.DuesStillNote}" Style="{StaticResource Muted}" FontSize="12" />
                        </Grid>
                        <!-- The result after the due too (user: dues first, then what is saved; ADR 0048 note) -->
                        <BoxView Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                        <Label Grid.Row="5" Text="{loc:Tr Reports_SavedAfterDue}" FontAttributes="Bold" FontSize="17" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding Model.ProjectedSavings}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource Primary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Model.ProjectedNegative}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Warn}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding Model.BeforeDueNote}" Style="{StaticResource Muted}" FontSize="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Spending by category -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Tr SpendingByCategory}" Style="{StaticResource H2}" />
                        <Label Grid.Column="1" Text="{Binding Model.SpendingTotal}" FontAttributes="Bold" />
                    </Grid>
                    <Label Text="{Binding Model.SpendingSub}" Style="{StaticResource Muted}" />
                    <Label Text="{loc:Tr Reports_TapHint}" Style="{StaticResource Muted}" TextColor="{StaticResource Info}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.Categories}" BindableLayout.ItemTemplate="{StaticResource BarRowTemplate}" />
                    <Label Text="{loc:Tr NoSpending}" Style="{StaticResource Muted}" IsVisible="{Binding Model.NoSpending}" />
                </VerticalStackLayout>
            </Border>

            <!-- Top items -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Tr Reports_TopItems}" Style="{StaticResource H2}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.TopItems}" BindableLayout.ItemTemplate="{StaticResource BarRowTemplate}" />
                    <Label Text="{loc:Tr NoItems}" Style="{StaticResource Muted}" IsVisible="{Binding Model.NoItems}" />
                </VerticalStackLayout>
            </Border>

            <!-- Trend -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Tr Last6Months}" Style="{StaticResource H2}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.Trend}" BindableLayout.ItemTemplate="{StaticResource BarRowTemplate}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
