<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.AddAccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:AddAccountViewModel"
    Shell.NavBarIsVisible="True"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Tr Name}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding Name}" Placeholder="{loc:Tr AccountName_Hint}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Tr AccountType}" Style="{StaticResource Caption}" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Types}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChipOption">
                            <Button Text="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource Chip}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{StaticResource Ink}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding OpeningLabel}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding OpeningText}" Keyboard="Numeric" Placeholder="0" />
                </Border>
            </VerticalStackLayout>

            <Button Text="{loc:Tr Save}" Command="{Binding SaveCommand}" Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
