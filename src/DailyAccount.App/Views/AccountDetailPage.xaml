<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.AccountDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:AccountDetailViewModel"
    Shell.NavBarIsVisible="True"
    Title="{Binding Name}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ‹ month › shared by every page (ADR 0029) -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ImageButton Source="chevron_left.png" Command="{Binding PreviousMonthCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Previous month" />
                <Label Grid.Column="1" Text="{Binding MonthTitle}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                <ImageButton Grid.Column="2" Source="chevron_right.png" Command="{Binding NextMonthCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Next month" />
            </Grid>
            <Border Style="{StaticResource Banner}" BackgroundColor="{StaticResource InfoTint}" IsVisible="{Binding IsPastMonth}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{loc:Tr Home_PastMonthNote}" TextColor="{StaticResource Info}" FontSize="14" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:Tr Home_BackToThisMonth}" Command="{Binding ThisMonthCommand}" Style="{StaticResource SmallOutline}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Name}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{loc:Tr Edit}" Command="{Binding EditCommand}" Style="{StaticResource SmallOutline}" />
                    </Grid>
                    <Label Text="{Binding BalanceTitle}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding Balance}" FontSize="30" FontAttributes="Bold" />
                    <Label Text="{Binding MonthSummary}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding Opening}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{loc:Tr History}" Style="{StaticResource H2}" />
            <Border Style="{StaticResource Card}" Padding="16,6">
                <VerticalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" BindableLayout.ItemTemplate="{StaticResource TxRowTemplate}" />
                    <Label Text="{loc:Tr NoTransactions}" Style="{StaticResource Muted}" IsVisible="{Binding IsEmpty}" Padding="0,10" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
