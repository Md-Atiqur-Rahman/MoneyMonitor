<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.PayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:PayViewModel"
    Shell.NavBarIsVisible="True"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout>
                <Label Text="{Binding Title}" Style="{StaticResource H1}" FontSize="20" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Banner}" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" StrokeThickness="1">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <Label Text="{loc:Tr Pay_DueAmount}" Style="{StaticResource Muted}" IsVisible="{Binding IsDue}" />
                    <Label Grid.Column="1" Text="{Binding DueAmount}" IsVisible="{Binding IsDue}" />
                    <Label Grid.Row="1" Text="{loc:Tr Pay_AlreadyPaid}" Style="{StaticResource Muted}" IsVisible="{Binding IsDue}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding AlreadyPaid}" IsVisible="{Binding IsDue}" />
                    <Label Grid.Row="2" Text="{Binding RemainingLabel}" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Remaining}" FontAttributes="Bold" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Tr Pay_AmountToPay}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding AmountText}" Keyboard="Numeric" FontSize="20" FontAttributes="Bold" />
                </Border>
                <Label Text="{loc:Tr Pay_PartialHint}" Style="{StaticResource Muted}" IsVisible="{Binding IsDue}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding AccountLabel}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Tr Date}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <DatePicker Date="{Binding Date}" Format="d MMM yyyy" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,2*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Text="{loc:Tr Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource Outline}" />
                <Button Grid.Column="1" Text="{Binding ButtonText}" Command="{Binding ConfirmCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
