<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:DashboardViewModel">

    <!-- Home (ADR 0018): five numbers, each card opens its details page. No income on purpose. -->
    <ContentPage.Resources>
        <Style x:Key="Chevron" TargetType="Label">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="TileTitle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
        </Style>
        <Style x:Key="TileAmount" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="{loc:Tr AppName}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding Model.MonthTitle}" Style="{StaticResource H1}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                        <ImageButton Source="reports.png" Command="{Binding OpenReportsCommand}"
                                     WidthRequest="44" HeightRequest="44" Padding="11" CornerRadius="22"
                                     BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1"
                                     SemanticProperties.Description="{loc:Tr Tab_Reports}" />
                        <ImageButton Source="settings.png" Command="{Binding OpenSettingsCommand}"
                                     WidthRequest="44" HeightRequest="44" Padding="11" CornerRadius="22"
                                     BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1"
                                     SemanticProperties.Description="{loc:Tr Settings_Title}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- First run -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding Model.HasNoAccounts}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Tr Dash_Welcome}" />
                        <Button Text="{loc:Tr AddAccount}" Command="{Binding AddAccountCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 1. Savings → Budget -->
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Model.SavingsIsNegative}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource WarnDark}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenBudgetCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Tr Home_Savings}" TextColor="White" Opacity="0.85" FontSize="15" />
                            <Label Text="{Binding Model.Savings}" TextColor="White" FontSize="34" FontAttributes="Bold" />
                            <Label Text="{Binding Model.SavingsSub}" TextColor="White" Opacity="0.9" FontSize="13" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" TextColor="White" />
                    </Grid>
                </Border>

                <!-- Budget this month (items only, without card/loan payments) → Budget -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenBudgetCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:Tr Home_Budget}" Style="{StaticResource TileTitle}" />
                            <Label Text="{Binding Model.BudgetSub}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Model.Budget}" Style="{StaticResource TileAmount}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </Border>

                <!-- 2. Total expenses → Reports -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenReportsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:Tr Home_Expenses}" Style="{StaticResource TileTitle}" />
                            <Label Text="{Binding Model.ExpensesSub}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Model.Expenses}" Style="{StaticResource TileAmount}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </Border>

                <!-- 3. Due = unpaid budget (+ non-card loans) → Dues page, which lists exactly these (ADR 0024) -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDuesCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:Tr Home_Due}" Style="{StaticResource TileTitle}" />
                            <Label Text="{Binding Model.DueSub}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Model.Due}" Style="{StaticResource TileAmount}" TextColor="{StaticResource Warn}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </Border>

                <!-- 4. Credit card payment with status → Liabilities (cards) -->
                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Model.Cards}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CardStatusRow">
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Open}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                    <Label Text="{loc:Tr Home_CardPayment}" Style="{StaticResource TileTitle}" />
                                    <Label Grid.Row="1" Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding Amount}" Style="{StaticResource TileAmount}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Chevron}" />
                                    <!-- Status chip on its own line, breakdown below it, so nothing is cut off. -->
                                    <Border Grid.Row="2" Grid.ColumnSpan="3" HorizontalOptions="Start" BackgroundColor="{Binding StatusBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,4">
                                        <Label Text="{Binding Status}" TextColor="{Binding StatusFg}" FontSize="13" FontAttributes="Bold" />
                                    </Border>
                                    <Label Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- 5. Bank Balance (all accounts) → Accounts -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAccountsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{loc:Tr Home_Accounts}" Style="{StaticResource TileTitle}" />
                            <Label Text="{Binding Model.BankSub}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Model.BankTotal}" Style="{StaticResource TileAmount}" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </Border>

                <!-- Last month: what it left for this month (ADR 0025) → Dues of last month -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding Model.HasPrev}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPrevDuesCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                        <Label Grid.ColumnSpan="2" Text="{Binding Model.PrevTitle}" Style="{StaticResource TileTitle}" />
                        <Label Grid.Column="2" Grid.RowSpan="5" Style="{StaticResource Chevron}" />
                        <Label Grid.Row="1" Text="{loc:Tr Home_PrevSaved}" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Model.PrevSaved}" FontSize="18" FontAttributes="Bold" HorizontalOptions="End" TextColor="{StaticResource Primary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Model.PrevSavedNegative}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Warn}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Model.PrevSub}" Style="{StaticResource Muted}" />
                        <Label Grid.Row="3" Text="{loc:Tr Home_PrevCard}" Style="{StaticResource Muted}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Model.PrevCard}" HorizontalOptions="End" />
                        <Label Grid.Row="4" Text="{loc:Tr Home_PrevCarried}" Style="{StaticResource Muted}" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Model.PrevCarried}" HorizontalOptions="End" />
                    </Grid>
                </Border>

                <!-- Next month forecast (last row) → Budget: card & loan payments + assumed savings -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenBudgetCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                        <Label Grid.ColumnSpan="2" Text="{Binding Model.NextTitle}" Style="{StaticResource TileTitle}" />
                        <Label Grid.Column="2" Grid.RowSpan="4" Style="{StaticResource Chevron}" />
                        <Label Grid.Row="1" Text="{loc:Tr Fc_Payments}" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Model.NextPayments}" FontSize="18" FontAttributes="Bold" HorizontalOptions="End" />
                        <Label Grid.Row="2" Text="{loc:Tr Home_AssumedSavings}" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Model.NextSave}" FontSize="18" FontAttributes="Bold" HorizontalOptions="End" TextColor="{StaticResource Primary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Model.NextIsShort}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Warn}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Model.NextSub}" Style="{StaticResource Muted}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="{StaticResource Ground}" StrokeThickness="0" Padding="20,8,20,12">
            <Button Text="{loc:Tr AddTx_Button}" Command="{Binding AddTransactionCommand}" BackgroundColor="{StaticResource Ink}" />
        </Border>
    </Grid>
</views:AppPage>
