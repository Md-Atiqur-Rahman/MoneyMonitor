<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.DuesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:DuesViewModel">

    <!-- Dues (ADR 0024): budget items not paid yet = the sheet's "Due" column (same total as Home),
         then card & loan payments as a separate section that is not part of that total. -->
    <ContentPage.Resources>
        <DataTemplate x:Key="BudgetDueTemplate" x:DataType="vm:BudgetDueRow">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6" Padding="8,10" Margin="-8,0">
                <Grid.Triggers>
                    <!-- Row opened from Budget → Due -->
                    <DataTrigger TargetType="Grid" Binding="{Binding Highlight}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource InfoTint}" />
                    </DataTrigger>
                </Grid.Triggers>
                <Label Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.Triggers>
                        <!-- "Won't pay this month" (ADR 0031) -->
                        <DataTrigger TargetType="Label" Binding="{Binding Struck}" Value="True">
                            <Setter Property="TextDecorations" Value="Strikethrough" />
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Label Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Amount}" TextColor="{Binding AmountColor}" Style="{StaticResource Amount}" HorizontalOptions="End" VerticalOptions="Center">
                    <Label.Triggers>
                        <!-- "Won't pay this month" (ADR 0031) -->
                        <DataTrigger TargetType="Label" Binding="{Binding Struck}" Value="True">
                            <Setter Property="TextDecorations" Value="Strikethrough" />
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="6" HorizontalOptions="End">
                    <Button Text="{Binding SecondText}" Command="{Binding Second}" IsVisible="{Binding HasSecond}" Style="{StaticResource SmallOutline}" />
                    <Button Text="{Binding ActionText}" Command="{Binding Action}" IsVisible="{Binding HasAction}" Style="{StaticResource SmallOutline}" />
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView x:Name="Scroller">
        <VerticalStackLayout Padding="20" Spacing="14">

            <!-- Month switcher (ADR 0025) -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ImageButton Source="chevron_left.png" Command="{Binding PreviousCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Previous month" />
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="{loc:Tr Dues_Title}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    <Label Text="{Binding Model.MonthTitle}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <ImageButton Grid.Column="2" Source="chevron_right.png" Command="{Binding NextCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Next month" />
            </Grid>

            <!-- The month's Due (same number as Home) -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Model.DueLabel}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Model.Due}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Warn}" />
                    <ProgressBar Progress="{Binding Model.Progress}" />
                    <!-- Total estimate / spent, with the bank balance and what is left after paying the due (ADR 0045) -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,4,0,0">
                        <Label Text="{loc:Tr Dues_TotalEstimate}" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding Model.TotalEstimate}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{loc:Tr Dues_TotalSpent}" Style="{StaticResource Muted}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Model.TotalSpent}" FontAttributes="Bold" />
                        <Label Grid.Row="2" Text="{Binding Model.BankLabel}" Style="{StaticResource Muted}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Model.BankBalance}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <BoxView Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Divider}" />
                        <Label Grid.Row="4" Text="{loc:Tr Dues_AfterDue}" FontAttributes="Bold" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Model.AfterDue}" FontAttributes="Bold" TextColor="{StaticResource Primary}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Model.AfterDueNegative}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource Warn}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Budget items not paid yet (+ non-card loans / dated personal dues) -->
            <Label Text="{loc:Tr Dues_NotPaid}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="16,10" IsVisible="{Binding Model.NothingDue}">
                <Label Text="{loc:Tr Dash_NoDues}" Style="{StaticResource Muted}" />
            </Border>

            <!-- 1. Liabilities: loans not on a card, personal borrowing due (ADR 0045) -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Model.HasOtherDues}">
                <Label Text="{loc:Tr Dues_Liabilities}" Style="{StaticResource H2}" />
                <Label Grid.Column="1" Text="{Binding Model.LiabilitiesTotal}" Style="{StaticResource H2}" TextColor="{StaticResource Warn}" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="16,4" IsVisible="{Binding Model.HasOtherDues}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.OtherDues}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
            </Border>

            <!-- 2. Expenses: budget items not paid yet -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Model.HasNotPaidExpenses}">
                <Label Text="{loc:Tr Dues_Expenses}" Style="{StaticResource H2}" />
                <Label Grid.Column="1" Text="{Binding Model.ExpensesTotal}" Style="{StaticResource H2}" TextColor="{StaticResource Warn}" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="16,4" IsVisible="{Binding Model.HasNotPaidExpenses}">
                <VerticalStackLayout x:Name="NotPaidList" BindableLayout.ItemsSource="{Binding Model.NotPaid}" BindableLayout.ItemTemplate="{StaticResource BudgetDueTemplate}" />
            </Border>

            <!-- Fully paid budget items -->
            <Label Text="{loc:Tr Dues_FullyPaid}" Style="{StaticResource Caption}" Margin="0,6,0,0" IsVisible="{Binding Model.HasFullyPaid}" />
            <Border Style="{StaticResource Card}" Padding="16,4" IsVisible="{Binding Model.HasFullyPaid}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.FullyPaid}" BindableLayout.ItemTemplate="{StaticResource BudgetDueTemplate}" />
            </Border>

            <!-- Struck through: won't pay this month, not in the Due (ADR 0031) -->
            <Label Text="{loc:Tr Dues_SkippedTitle}" Style="{StaticResource Caption}" Margin="0,6,0,0" IsVisible="{Binding Model.HasSkipped}" />
            <Border Style="{StaticResource Card}" Padding="16,4" IsVisible="{Binding Model.HasSkipped}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.Skipped}" BindableLayout.ItemTemplate="{StaticResource BudgetDueTemplate}" />
            </Border>

            <!-- ===== Card & loan payments: separate, not in the Due above ===== -->
            <VerticalStackLayout Spacing="14" Margin="0,10,0,0" IsVisible="{Binding Model.HasCardSection}">
                <BoxView Style="{StaticResource Divider}" />
                <VerticalStackLayout Spacing="2">
                    <Label Text="{loc:Tr Dues_CardLoans}" Style="{StaticResource H2}" />
                    <Label Text="{loc:Tr Dues_CardLoansHint}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding Model.HasCardThisMonth}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.CardThisMonth}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
                </Border>

                <Label Text="{loc:Tr Dues_NoDate}" Style="{StaticResource Caption}" IsVisible="{Binding Model.HasNoDate}" />
                <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding Model.HasNoDate}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.NoDate}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
                </Border>

                <Label Text="{loc:Tr Dues_PaidSection}" Style="{StaticResource Caption}" IsVisible="{Binding Model.HasCardPaid}" />
                <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding Model.HasCardPaid}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.CardPaid}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
                </Border>

                <Label Text="{Binding Model.NextMonthTitle}" Style="{StaticResource Caption}" IsVisible="{Binding Model.HasNextMonth}" />
                <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding Model.HasNextMonth}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.NextMonth}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
