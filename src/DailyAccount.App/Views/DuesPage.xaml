<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.DuesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:DuesViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <VerticalStackLayout>
                <Label Text="{loc:Tr Dues_Title}" Style="{StaticResource Caption}" />
                <Label Text="{Binding Model.MonthTitle}" Style="{StaticResource H1}" />
            </VerticalStackLayout>

            <!-- Totals -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="{loc:Tr Total}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Model.Total}" Style="{StaticResource Amount}" FontSize="17" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{loc:Tr Paid}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Model.Paid}" Style="{StaticResource Amount}" FontSize="17" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="{loc:Tr Remaining}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Model.Remaining}" Style="{StaticResource Amount}" FontSize="17" TextColor="{StaticResource Warn}" />
                        </VerticalStackLayout>
                    </Grid>
                    <ProgressBar Progress="{Binding Model.Progress}" />
                    <Label Text="{Binding Model.OverdueText}" Style="{StaticResource Muted}" TextColor="{StaticResource Warn}" IsVisible="{Binding Model.HasOverdue}" />
                </VerticalStackLayout>
            </Border>

            <!-- To pay (this month + overdue) -->
            <Label Text="{loc:Tr Dues_Pending}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            <Border Style="{StaticResource Card}" Padding="16,6">
                <VerticalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.Pending}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
                    <Label Text="{loc:Tr Dash_NoDues}" Style="{StaticResource Muted}" IsVisible="{Binding Model.PendingEmpty}" Padding="0,10" />
                </VerticalStackLayout>
            </Border>

            <!-- Personal borrowing without a date -->
            <Label Text="{loc:Tr Dues_NoDate}" Style="{StaticResource Caption}" Margin="0,6,0,0" IsVisible="{Binding Model.HasNoDate}" />
            <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding Model.HasNoDate}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.NoDate}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
            </Border>

            <!-- Paid -->
            <Label Text="{loc:Tr Dues_PaidSection}" Style="{StaticResource Caption}" Margin="0,6,0,0" IsVisible="{Binding Model.HasPaid}" />
            <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding Model.HasPaid}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.PaidRows}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
            </Border>

            <!-- Next month -->
            <Label Text="{Binding Model.NextMonthTitle}" Style="{StaticResource Caption}" Margin="0,6,0,0" IsVisible="{Binding Model.HasNextMonth}" />
            <Border Style="{StaticResource Card}" Padding="16,6" IsVisible="{Binding Model.HasNextMonth}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Model.NextMonth}" BindableLayout.ItemTemplate="{StaticResource DueRowTemplate}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
