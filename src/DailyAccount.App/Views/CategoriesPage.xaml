<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:CategoriesViewModel"
    Shell.NavBarIsVisible="True"
    Title="{loc:Tr Categories_Title}">

    <ContentPage.Resources>
        <DataTemplate x:Key="CategoryRowTemplate" x:DataType="vm:CategoryRow">
            <Grid Padding="0,12" Margin="{Binding Indent}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Tap}" />
                </Grid.GestureRecognizers>
                <Label Text="{Binding Name}" FontAttributes="{Binding Weight}" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{loc:Tr ManageCategoriesHint}" Style="{StaticResource Muted}" />
            <Button Text="{loc:Tr AddCategory}" Command="{Binding AddCommand}" Style="{StaticResource Outline}" />

            <Label Text="{loc:Tr ExpenseCategories}" Style="{StaticResource Caption}" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expense}" BindableLayout.ItemTemplate="{StaticResource CategoryRowTemplate}" />
            </Border>

            <Label Text="{loc:Tr IncomeCategories}" Style="{StaticResource Caption}" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Income}" BindableLayout.ItemTemplate="{StaticResource CategoryRowTemplate}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
