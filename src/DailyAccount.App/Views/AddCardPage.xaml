<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.AddCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:AddCardViewModel"
    Shell.NavBarIsVisible="True"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Tr CardName}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding Name}" Placeholder="{loc:Tr Ph_CardName}" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Tr CreditLimit}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding LimitText}" Keyboard="Numeric" Placeholder="{loc:Tr Ph_Limit}" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Tr StatementDay}" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding StatementDayText}" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="{loc:Tr DueDay}" Style="{StaticResource Caption}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding DueDayText}" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Tr PayFrom}" Style="{StaticResource Caption}" />
                <Border Style="{StaticResource Field}">
                    <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding PayFrom}" />
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource Banner}" BackgroundColor="{StaticResource InfoTint}">
                <Label Text="{loc:Tr Hint_Card}" TextColor="{StaticResource Info}" FontSize="14" />
            </Border>

            <Button Text="{loc:Tr Save}" Command="{Binding SaveCommand}" Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
