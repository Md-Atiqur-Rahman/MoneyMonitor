<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage
    x:Class="DailyAccount.App.Views.LiabilitiesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:DailyAccount.App.Localization"
    xmlns:views="clr-namespace:DailyAccount.App.Views"
    xmlns:vm="clr-namespace:DailyAccount.App.ViewModels"
    x:DataType="vm:LiabilitiesViewModel">

    <ContentPage.Resources>
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <DataTemplate x:Key="DebtTemplate" x:DataType="vm:DebtRow">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="0,10" RowSpacing="6">
                <Label Text="{Binding Name}" FontAttributes="Bold" />
                <Label Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                <Label Grid.Column="1" Text="{Binding Remaining}" TextColor="{Binding RemainingColor}" Style="{StaticResource Amount}" HorizontalOptions="End" />
                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6" HorizontalOptions="End">
                    <Button Text="{Binding SecondText}" Command="{Binding Second}" IsVisible="{Binding HasSecond}" Style="{StaticResource SmallOutline}" />
                    <Button Text="{Binding ActionText}" Command="{Binding Action}" IsVisible="{Binding CanAct}" Style="{StaticResource Small}" />
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{loc:Tr Liab_Title}" Style="{StaticResource H1}" />

            <!-- ‹ month › shared by every page (ADR 0029) -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ImageButton Source="chevron_left.png" Command="{Binding PreviousMonthCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Previous month" />
                <Label Grid.Column="1" Text="{Binding MonthTitle}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                <ImageButton Grid.Column="2" Source="chevron_right.png" Command="{Binding NextMonthCommand}" WidthRequest="44" HeightRequest="44" Padding="10" CornerRadius="22"
                             BackgroundColor="{StaticResource Surface}" BorderColor="{StaticResource Line}" BorderWidth="1" SemanticProperties.Description="Next month" />
            </Grid>
            <Border Style="{StaticResource Banner}" BackgroundColor="{StaticResource InfoTint}" IsVisible="{Binding IsPastMonth}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{loc:Tr Home_PastMonthNote}" TextColor="{StaticResource Info}" FontSize="14" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:Tr Home_BackToThisMonth}" Command="{Binding ThisMonthCommand}" Style="{StaticResource SmallOutline}" />
                </Grid>
            </Border>

            <!-- Card face, always on top (ADR 0023): this month's payment first, then what is available -->
            <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Cards}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CardRow">
                        <Border BackgroundColor="{StaticResource Info}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20,16">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" TextColor="White" FontSize="17" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="{loc:Tr Edit}" Command="{Binding Edit}" Style="{StaticResource Small}" BackgroundColor="#2D5694" />
                                </Grid>
                                <Label Text="{loc:Tr Card_ThisMonth}" TextColor="#C8D6EE" FontSize="13" />
                                <Label Text="{Binding ThisMonth}" TextColor="White" FontSize="28" FontAttributes="Bold" />
                                <BoxView HeightRequest="1" Color="#4A6FA8" Margin="0,4" />
                                <Label Text="{Binding Available}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <ProgressBar Progress="{Binding UsedProgress}" ProgressColor="White" />
                                <Label Text="{Binding LimitText}" TextColor="#C8D6EE" FontSize="13" />
                                <Label Text="{Binding Subtitle}" TextColor="#C8D6EE" FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>


            <!-- Section switch -->
            <Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 24" Padding="4">
                <!-- Cards | This month | Last month | Loans | Personal (ADR 0031): two rows so the words fit -->
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="2" RowSpacing="2">
                    <Button Grid.Column="0" Text="{loc:Tr Cards}" Command="{Binding ShowSectionCommand}" CommandParameter="1" Style="{StaticResource Seg}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowCards}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="{loc:Tr Liab_ThisMonth}" Command="{Binding ShowSectionCommand}" CommandParameter="4" Style="{StaticResource Seg}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowThis}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="{loc:Tr Liab_LastMonth}" Command="{Binding ShowSectionCommand}" CommandParameter="3" Style="{StaticResource Seg}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowPast}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="0" Text="{loc:Tr Loans}" Command="{Binding ShowSectionCommand}" CommandParameter="0" Style="{StaticResource Seg}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowLoans}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Text="{loc:Tr Personal}" Command="{Binding ShowSectionCommand}" CommandParameter="2" Style="{StaticResource Seg}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowOther}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Loans ===== -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowLoans}">
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Loans}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LoanRow">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <ImageButton Grid.Column="1" Source="trash.png" Command="{Binding Delete}" IsVisible="{Binding CanDelete}"
                                                     WidthRequest="40" HeightRequest="40" Padding="10" BackgroundColor="Transparent"
                                                     SemanticProperties.Description="{loc:Tr Delete}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ProgressText}" FontAttributes="Bold" FontSize="13" />
                                        <Label Grid.Column="1" Text="{Binding Remaining}" Style="{StaticResource Muted}" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding Progress}" />
                                    <Label Text="{Binding NextText}" FontSize="14" />
                                    <!-- Change month · Convert to EMI · Pay (ADR 0034) -->
                                    <FlexLayout Wrap="Wrap" JustifyContent="End" IsVisible="{Binding HasActions}">
                                        <Button Text="{loc:Tr Debt_ChangeMonth}" Command="{Binding Move}" IsVisible="{Binding CanMove}" Style="{StaticResource SmallOutline}" Margin="0,0,6,6" />
                                        <Button Text="{loc:Tr Loan_Convert}" Command="{Binding Convert}" IsVisible="{Binding CanConvert}" Style="{StaticResource SmallOutline}" Margin="0,0,6,6" />
                                        <Button Text="{loc:Tr Repay}" Command="{Binding Pay}" IsVisible="{Binding CanPay}" Style="{StaticResource Small}" Margin="0,0,0,6" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="{loc:Tr AddLoan}" Command="{Binding AddLoanCommand}" Style="{StaticResource Outline}" />
            </VerticalStackLayout>

            <!-- ===== Cards ===== -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowCards}">
                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Cards}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CardRow">
                            <VerticalStackLayout Spacing="12">
                                <!-- This month: EMIs + last month's purchases -->
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{loc:Tr Card_ThisMonth}" Style="{StaticResource Caption}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding ThisMonth}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Warn}" VerticalOptions="Center">
                                                <!-- A paid bill is green, not the "to pay" orange -->
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding ThisMonthPaid}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Button Grid.Column="1" Text="{loc:Tr Card_PayBill}" Command="{Binding Pay}" IsVisible="{Binding CanPay}" Style="{StaticResource Small}" />
                                        </Grid>
                                        <Label Text="{Binding ThisMonthSub}" Style="{StaticResource Muted}" IsVisible="{Binding CanPay}" />
                                        <!-- Purchases on this bill: one total line; tap → "Last month" tab (ADR 0022) -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0" IsVisible="{Binding HasBillPurchases}">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowBillPurchases}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout>
                                                <Label Text="{loc:Tr Card_BillPurchases}" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding BillPurchases}" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="›" FontSize="24" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView Style="{StaticResource Divider}" Margin="0,6" />
                                        <!-- Next month so far (ADR 0031): EMI → Loans tab, Purchases → This month tab -->
                                        <Label Text="{Binding NextMonthTitle}" Style="{StaticResource Caption}" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                            <Label Text="{loc:Tr Card_NextEmi}" VerticalOptions="Center">
                                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowLoans}" /></Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding NextEmi}" FontAttributes="Bold" HorizontalOptions="End">
                                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowLoans}" /></Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Muted}">
                                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowLoans}" /></Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Row="1" Text="{loc:Tr Card_NextPurchases}" VerticalOptions="Center">
                                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowThisMonth}" /></Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding NextPurchases}" FontAttributes="Bold" HorizontalOptions="End">
                                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowThisMonth}" /></Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Row="1" Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource Muted}">
                                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowThisMonth}" /></Label.GestureRecognizers>
                                            </Label>
                                            <BoxView Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Divider}" />
                                            <Label Grid.Row="3" Text="{loc:Tr Card_NextTotal}" FontAttributes="Bold" />
                                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding NextTotal}" FontSize="18" FontAttributes="Bold" HorizontalOptions="End" />
                                        </Grid>
                                        <Label Text="{Binding NextSub}" Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Button Text="{loc:Tr AddCard}" Command="{Binding AddCardCommand}" Style="{StaticResource Outline}" />
            </VerticalStackLayout>

            <!-- ===== This month's card purchases (ADR 0031) ===== -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowThis}">
                <Label Text="{loc:Tr Liab_ThisMonthHint}" Style="{StaticResource Muted}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding ThisMonthPurchases}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PurchaseGroup">
                            <Border Style="{StaticResource Card}" Padding="16,10">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                                            <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Total}" Style="{StaticResource Amount}" VerticalOptions="Center" />
                                    </Grid>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" BindableLayout.ItemTemplate="{StaticResource TxRowTemplate}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{loc:Tr Dues_Nothing}" Style="{StaticResource Muted}" IsVisible="{Binding ThisEmpty}" />
            </VerticalStackLayout>

            <!-- ===== Card purchases of earlier months (ADR 0022) ===== -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowPast}">
                <Label Text="{loc:Tr Liab_LastMonthHint}" Style="{StaticResource Muted}" />
                <Label Text="{loc:Tr Dues_Nothing}" Style="{StaticResource Muted}" IsVisible="{Binding PastEmpty}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding PastPurchases}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PurchaseGroup">
                            <Border Style="{StaticResource Card}" Padding="16,12">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                                        <Label Grid.Column="1" Text="{Binding Total}" Style="{StaticResource Amount}" FontSize="16" />
                                    </Grid>
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                                    <BoxView Style="{StaticResource Divider}" Margin="0,4" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" BindableLayout.ItemTemplate="{StaticResource TxRowTemplate}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===== Personal ===== -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowOther}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{loc:Tr Borrowed_Section}" Style="{StaticResource H2}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:Tr Borrow}" Command="{Binding BorrowCommand}" Style="{StaticResource SmallOutline}" />
                </Grid>
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Borrowed}" BindableLayout.ItemTemplate="{StaticResource DebtTemplate}" />
                        <Label Text="{loc:Tr Dues_Nothing}" Style="{StaticResource Muted}" IsVisible="{Binding BorrowedEmpty}" Padding="0,10" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <Label Text="{loc:Tr Lent_Section}" Style="{StaticResource H2}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{loc:Tr Lend}" Command="{Binding LendCommand}" Style="{StaticResource SmallOutline}" />
                </Grid>
                <Border Style="{StaticResource Card}" Padding="16,6">
                    <VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lent}" BindableLayout.ItemTemplate="{StaticResource DebtTemplate}" />
                        <Label Text="{loc:Tr Dues_Nothing}" Style="{StaticResource Muted}" IsVisible="{Binding LentEmpty}" Padding="0,10" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>


            <!-- Total owed, at the bottom (ADR 0023); every part opens its tab -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr Liab_TotalOwe}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding TotalOwe}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Warn}" />
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="10">
                        <!-- This month (ADR 0031) -->
                        <VerticalStackLayout Grid.Column="1">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="4" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{loc:Tr Liab_ThisMonth}" Style="{StaticResource Muted}" FontSize="12" TextDecorations="Underline" />
                            <Label Text="{Binding ThisMonthOwe}" FontAttributes="Bold" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="1" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{loc:Tr Cards}" Style="{StaticResource Muted}" FontSize="12" TextDecorations="Underline" />
                            <Label Text="{Binding CardsOwe}" FontAttributes="Bold" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="3" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{loc:Tr Liab_LastMonth}" Style="{StaticResource Muted}" FontSize="12" TextDecorations="Underline" />
                            <Label Text="{Binding LastMonthOwe}" FontAttributes="Bold" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="0" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{loc:Tr Loans}" Style="{StaticResource Muted}" FontSize="12" TextDecorations="Underline" />
                            <Label Text="{Binding LoansOwe}" FontAttributes="Bold" FontSize="12" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="2" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{loc:Tr Personal}" Style="{StaticResource Muted}" FontSize="12" TextDecorations="Underline" />
                            <Label Text="{Binding PersonalOwe}" FontAttributes="Bold" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</views:AppPage>
